# Server Runtime
NODE_ENV=development
PORT=5000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=fixmate

# Frontend & CORS Origins (no trailing slash)
CLIENT_URL=http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000

# BetterAuth JWT Verification
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=http://localhost:3000

# Stripe Payments (Test Mode)
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_signing_secret

# ImgBB Image Upload Proxy
IMGBB_API_KEY=replace_with_your_imgbb_api_key